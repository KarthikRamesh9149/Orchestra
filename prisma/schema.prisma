model Organization {
  id                               String                           @id @default(uuid()) @db.Uuid
  name                             String
  slug                             String                           @unique
  createdAt                        DateTime                         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                        DateTime                         @updatedAt @map("updated_at") @db.Timestamptz(6)
  users                            User[]
  memberships                      OrganizationMembership[]
  projects                         Project[]
  tokens                           RefreshToken[]
  audits                           AuditEvent[]
  dashboardSnapshots               DashboardSnapshot[]
  oauthStates                      OAuthState[]
  clientShares                     ProjectClientShare[]
  projectEvents                    ProjectEvent[]
  projectDeadlines                 ProjectDeadline[]
  projectFinancials                ProjectFinancialSummary[]
  projectSubscriptions             ProjectSubscription[]
  projectEventSeries               ProjectEventSeries[]
  calendarConnections              ProjectCalendarConnection[]
  calendarSyncRuns                 ProjectCalendarSyncRun[]
  driveConnections                 ProjectDriveConnection[]
  driveSyncRoots                   ProjectDriveSyncRoot[]
  driveFiles                       ProjectDriveFile[]
  notionResources                  ProjectNotionResource[]
  driveSyncRuns                    ProjectDriveSyncRun[]
  driveWatchChannels               ProjectDriveWatchChannel[]
  projectCostEntries               ProjectCostEntry[]
  liveDocSources                   ProjectLiveDocSource[]
  projectResponsibilities          ProjectResponsibility[]
  projectContextEntries            ProjectContextEntry[]
  projectContextChunks             ProjectContextChunk[]
  projectContextAttachments        ProjectContextAttachment[]
  projectDiagrams                  ProjectDiagram[]
  liveDocSectionDiagrams           LiveDocSectionDiagram[]
  projectCodingRequirements        ProjectCodingRequirements[]
  socratesActions                  SocratesAction[]
  githubInstallations              GitHubInstallation[]
  githubRepositories               GitHubRepository[]
  githubRepositoryLinks            GitHubRepositoryProjectLink[]
  githubUserLinks                  GitHubUserLink[]
  githubOAuthStates                GitHubOAuthState[]
  githubWebhookEvents              GitHubWebhookEvent[]
  githubSyncRuns                   GitHubSyncRun[]
  githubEvidenceItems              GitHubEngineeringEvidence[]
  engineeringEvidenceItems         EngineeringEvidenceItem[]
  engineeringEvidenceRefreshRuns   EngineeringEvidenceRefreshRun[]
  engineeringEvidenceManualEntries EngineeringEvidenceManualEntry[]
  fdeReadinessFindings             FdeReadinessFinding[]
  fdeReadinessRuns                 FdeReadinessRun[]
  fdeRationaleTraces               FdeRationaleTrace[]
  fdeDecisionEngineeringLinks      FdeDecisionEngineeringLink[]
  editorConnectors                 ProjectEditorConnector[]
  projectJoinCodes                 ProjectJoinCode[]
  notificationPreferences          UserNotificationPreference[]
  truthInboxItemStates             TruthInboxItemState[]
  decisionReceipts                 DecisionReceipt[]
  socratesResponseFeedback         SocratesResponseFeedback[]
  weeklyExecutiveBriefs            WeeklyExecutiveBrief[]

  @@map("organizations")
}

model User {
  id                                      String                           @id @default(uuid()) @db.Uuid
  orgId                                   String                           @map("org_id") @db.Uuid
  email                                   String
  normalizedEmail                         String                           @unique @map("normalized_email")
  passwordHash                            String?                          @map("password_hash")
  displayName                             String                           @map("display_name")
  jobTitle                                String?                          @map("job_title")
  avatarUrl                               String?                          @map("avatar_url")
  timezone                                String?                          @map("timezone")
  locale                                  String?                          @map("locale")
  emailVerifiedAt                         DateTime?                        @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt                             DateTime?                        @map("last_login_at") @db.Timestamptz(6)
  globalRole                              GlobalRole                       @map("global_role")
  workspaceRoleDefault                    WorkspaceRoleDefault             @map("workspace_role_default")
  isActive                                Boolean                          @default(true) @map("is_active")
  createdAt                               DateTime                         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                               DateTime                         @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization                            Organization                     @relation(fields: [orgId], references: [id])
  organizationMemberships                 OrganizationMembership[]
  refreshTokens                           RefreshToken[]
  createdProjects                         Project[]                        @relation("created_projects")
  memberships                             ProjectMember[]
  uploadedDocuments                       Document[]                       @relation("uploaded_documents")
  uploadedVersions                        DocumentVersion[]                @relation("uploaded_versions")
  artifacts                               ArtifactVersion[]                @relation("created_artifacts")
  acceptedProposals                       SpecChangeProposal[]             @relation("accepted_proposals")
  acceptedDecisions                       DecisionRecord[]                 @relation("accepted_decisions")
  audits                                  AuditEvent[]
  socrateSessions                         SocratesSession[]                @relation("socrates_sessions")
  createdConnectors                       CommunicationConnector[]         @relation("created_connectors")
  oauthStates                             OAuthState[]                     @relation("oauth_actor")
  createdClientShares                     ProjectClientShare[]             @relation("client_share_creator")
  liveDocDrafts                           LiveDocSectionDraft[]            @relation("live_doc_draft_creator")
  liveDocComments                         LiveDocComment[]                 @relation("live_doc_comment_author")
  liveDocRevisions                        LiveDocSectionRevision[]         @relation("live_doc_revision_actor")
  liveDocSourcesSet                       ProjectLiveDocSource[]           @relation("live_doc_source_setter")
  createdProjectEvents                    ProjectEvent[]                   @relation("created_project_events")
  createdProjectDeadlines                 ProjectDeadline[]                @relation("created_project_deadlines")
  updatedProjectFinancials                ProjectFinancialSummary[]        @relation("updated_project_financials")
  createdProjectSubscriptions             ProjectSubscription[]            @relation("created_project_subscriptions")
  createdEventSeries                      ProjectEventSeries[]             @relation("created_event_series")
  createdCalendarConnections              ProjectCalendarConnection[]      @relation("created_calendar_connections")
  createdDriveConnections                 ProjectDriveConnection[]         @relation("created_drive_connections")
  startedDriveSyncRuns                    ProjectDriveSyncRun[]            @relation("drive_sync_starter")
  createdCostEntries                      ProjectCostEntry[]               @relation("created_cost_entries")
  createdProjectResponsibilities          ProjectResponsibility[]          @relation("created_project_responsibilities")
  updatedProjectResponsibilities          ProjectResponsibility[]          @relation("updated_project_responsibilities")
  createdProjectContextEntries            ProjectContextEntry[]            @relation("created_project_context_entries")
  updatedProjectContextEntries            ProjectContextEntry[]            @relation("updated_project_context_entries")
  deletedProjectContextEntries            ProjectContextEntry[]            @relation("deleted_project_context_entries")
  createdProjectContextAttachments        ProjectContextAttachment[]       @relation("created_project_context_attachments")
  createdProjectDiagrams                  ProjectDiagram[]                 @relation("created_project_diagrams")
  updatedProjectDiagrams                  ProjectDiagram[]                 @relation("updated_project_diagrams")
  deletedProjectDiagrams                  ProjectDiagram[]                 @relation("deleted_project_diagrams")
  embeddedLiveDocSectionDiagrams          LiveDocSectionDiagram[]          @relation("embedded_live_doc_section_diagrams")
  generatedCodingRequirements             ProjectCodingRequirements[]      @relation("generated_coding_requirements")
  createdSocratesActions                  SocratesAction[]                 @relation("created_socrates_actions")
  appliedSocratesActions                  SocratesAction[]                 @relation("applied_socrates_actions")
  rejectedSocratesActions                 SocratesAction[]                 @relation("rejected_socrates_actions")
  linkedGitHubRepositories                GitHubRepositoryProjectLink[]    @relation("github_repository_linker")
  githubUserLinks                         GitHubUserLink[]
  githubOAuthStates                       GitHubOAuthState[]               @relation("github_oauth_state_actor")
  startedGitHubSyncRuns                   GitHubSyncRun[]                  @relation("github_sync_starter")
  mappedGitHubEvidence                    GitHubEngineeringEvidence[]      @relation("github_evidence_mapped_user")
  mappedEngineeringEvidence               EngineeringEvidenceItem[]        @relation("engineering_evidence_mapped_user")
  createdEngineeringEvidenceManualEntries EngineeringEvidenceManualEntry[] @relation("engineering_evidence_manual_creator")
  createdFdeReadinessFindings             FdeReadinessFinding[]            @relation("fde_readiness_finding_creator")
  createdFdeReadinessRuns                 FdeReadinessRun[]                @relation("fde_readiness_run_creator")
  createdFdeRationaleTraces               FdeRationaleTrace[]              @relation("fde_rationale_trace_creator")
  createdFdeDecisionLinks                 FdeDecisionEngineeringLink[]     @relation("fde_decision_link_creator")
  editorConnectors                        ProjectEditorConnector[]         @relation("editor_connector_creator")
  createdProjectJoinCodes                 ProjectJoinCode[]                @relation("project_join_code_creator")
  projectJoinCodeRedemptions              ProjectJoinCodeRedemption[]
  emailVerificationTokens                 UserEmailVerificationToken[]
  notificationPreferences                 UserNotificationPreference?
  assignedTruthInboxItems                 TruthInboxItemState[]             @relation("truth_inbox_assignee")
  actedTruthInboxItems                    TruthInboxItemState[]             @relation("truth_inbox_actor")
  clarificationTruthInboxItems            TruthInboxItemState[]             @relation("truth_inbox_clarification_actor")
  issuedDecisionReceipts                  DecisionReceipt[]                 @relation("decision_receipt_issuer")
  socratesResponseFeedback                SocratesResponseFeedback[]        @relation("socrates_feedback_author")
  generatedWeeklyBriefs                   WeeklyExecutiveBrief[]            @relation("weekly_brief_generator")

  @@unique([orgId, email])
  @@map("users")
}

model OrganizationMembership {
  id                   String               @id @default(uuid()) @db.Uuid
  organizationId       String               @map("organization_id") @db.Uuid
  userId               String               @map("user_id") @db.Uuid
  globalRole           GlobalRole           @map("global_role")
  workspaceRoleDefault WorkspaceRoleDefault @map("workspace_role_default")
  isActive             Boolean              @default(true) @map("is_active")
  joinedAt             DateTime             @default(now()) @map("joined_at") @db.Timestamptz(6)
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId, isActive])
  @@index([organizationId, isActive, globalRole])
  @@map("organization_memberships")
}

model UserNotificationPreference {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @unique @map("user_id") @db.Uuid
  orgId             String       @map("org_id") @db.Uuid
  productUpdates    Boolean      @default(false) @map("product_updates")
  projectActivity   Boolean      @default(true) @map("project_activity")
  approvalRequests  Boolean      @default(true) @map("approval_requests")
  slackSyncAlerts   Boolean      @default(true) @map("slack_sync_alerts")
  calendarReminders Boolean      @default(true) @map("calendar_reminders")
  socratesDigests   Boolean      @default(false) @map("socrates_digests")
  securityAlerts    Boolean      @default(true) @map("security_alerts")
  emailEnabled      Boolean      @default(true) @map("email_enabled")
  inAppEnabled      Boolean      @default(true) @map("in_app_enabled")
  appearanceTheme   String       @default("auto") @map("appearance_theme")
  metadataJson      Json         @default("{}") @map("metadata_json")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  user              User         @relation(fields: [userId], references: [id])
  organization      Organization @relation(fields: [orgId], references: [id])

  @@index([orgId])
  @@map("user_notification_preferences")
}

model RefreshToken {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  orgId           String         @map("org_id") @db.Uuid
  sessionId       String         @default(uuid()) @map("session_id") @db.Uuid
  parentTokenId   String?        @map("parent_token_id") @db.Uuid
  clientType      String         @default("bearer") @map("client_type")
  tokenHash       String         @unique @map("token_hash")
  expiresAt       DateTime       @map("expires_at") @db.Timestamptz(6)
  revokedAt       DateTime?      @map("revoked_at") @db.Timestamptz(6)
  replacedAt      DateTime?      @map("replaced_at") @db.Timestamptz(6)
  reuseDetectedAt DateTime?      @map("reuse_detected_at") @db.Timestamptz(6)
  revokeReason    String?        @map("revoke_reason")
  activeProjectId String?        @map("active_project_id") @db.Uuid
  deviceLabel     String?        @map("device_label")
  deviceType      String?        @map("device_type")
  userAgentHash   String?        @map("user_agent_hash")
  ipAddressHash   String?        @map("ip_address_hash")
  ipLabel         String?        @map("ip_label")
