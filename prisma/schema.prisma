  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("job_runs")
}

// ─── Feature 6: Client Portal ───────────────────────────────────────────────

enum ClientShareStatus {
  active
  revoked
  expired
}

model ProjectClientShare {
  id             String            @id @default(uuid()) @db.Uuid
  projectId      String            @map("project_id") @db.Uuid
  orgId          String            @map("org_id") @db.Uuid
  name           String
  tokenHash      String            @unique @map("token_hash")
  tokenPrefix    String            @map("token_prefix")
  status         ClientShareStatus @default(active)
  expiresAt      DateTime?         @map("expires_at") @db.Timestamptz(6)
  revokedAt      DateTime?         @map("revoked_at") @db.Timestamptz(6)
  revokedBy      String?           @map("revoked_by") @db.Uuid
  createdBy      String            @map("created_by") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastAccessedAt DateTime?         @map("last_accessed_at") @db.Timestamptz(6)
  configJson     Json?             @map("config_json")
  project        Project           @relation(fields: [projectId], references: [id])
  organization   Organization      @relation(fields: [orgId], references: [id])
  creator        User              @relation("client_share_creator", fields: [createdBy], references: [id])

  @@index([projectId, status])
  @@index([orgId, status])
  @@index([expiresAt])
  @@map("project_client_shares")
}
